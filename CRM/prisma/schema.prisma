// Crown Celebrity Aesthetic CRM — data model
// Outpatient aesthetic, trichology, PMU, and hair transplant clinic CRM:
// Patient CRM, Appointments, EMR, Leads Pipeline, Inventory, Billing, and Content Management.
// workflow), Billing, and Website content management. Hospital-operations
// (beds/ICU/OT/ambulance/pharmacy-inventory) and HRMS (payroll/recruitment/
// chat/etc.) were dropped — see ARCHITECTURE.md for the audit that justifies
// each removal.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Connection URL lives in prisma.config.ts (Prisma 7+ moved it out of the
// schema file). Points to DATABASE_URL in .env.
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────
// Staff identity + auth
// ─────────────────────────────────────────────────────────────────────────

enum StaffRole {
  ADMIN
  DOCTOR
  RECEPTIONIST
  BILLING
  NURSE
  TECHNICIAN
  SALES
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  phone           String?
  passwordHash    String
  role            StaffRole
  specialization  String?
  consultationFee Decimal?  @db.Decimal(10, 2)
  active          Boolean   @default(true)
  permissions     Json?
  createdAt       DateTime  @default(now())

  sessions Session[]

  registeredPatients   Patient[]            @relation("PatientRegisteredBy")
  doctorAvailabilities DoctorAvailability[]
  doctorLeaves         DoctorLeave[]
  appointmentsAsDoctor Appointment[]        @relation("AppointmentDoctor")
  appointmentsCreated  Appointment[]        @relation("AppointmentCreatedBy")
  prescriptionsWritten Prescription[]       @relation("PrescriptionDoctor")
  documentsUploaded    Document[]           @relation("DocumentUploadedBy")
  messagesSent         Message[]            @relation("MessageSentBy")
  notesWritten         PatientNote[]        @relation("NoteAuthor")
  followUpsAssigned    FollowUp[]           @relation("FollowUpAssignedTo")
  waitingListEntries   WaitingListEntry[]   @relation("WaitingListDoctor")

  encountersAsDoctor     Encounter[]       @relation("EncounterDoctor")
  clinicalNotesWritten   ClinicalNote[]    @relation("ClinicalNoteDoctor")
  doctorTemplates        DoctorTemplate[]  @relation("DoctorTemplateOwner")
  digitalSignature       DigitalSignature? @relation("DoctorSignature")
  clinicalReportsOrdered ClinicalReport[]  @relation("ClinicalReportDoctor")
  referralsWritten       ReferralNote[]    @relation("ReferralFromDoctor")
  certificatesIssued     Certificate[]     @relation("CertificateDoctor")

  paymentsReceived   Payment[]        @relation("PaymentReceivedBy")
  refundsProcessed   Refund[]         @relation("RefundProcessedBy")
  advancesReceived   PatientAdvance[] @relation("AdvanceReceivedBy")
  cashSessionsOpened CashSession[]    @relation("CashSessionOpenedBy")
  cashSessionsClosed CashSession[]    @relation("CashSessionClosedBy")
  expensesRecorded   Expense[]        @relation("ExpenseRecordedBy")

  inventoryTransactions    InventoryTransaction[] @relation("InventoryPerformedBy")
  auditLogs                AuditLog[]             @relation("AuditUser")
  packageSessionsPerformed PackageSessionLog[]    @relation("PackageSessionPerformedBy")
  paymentPlansCreated      PaymentPlan[]          @relation("PaymentPlanCreatedBy")
  purchaseOrdersCreated    PurchaseOrder[]        @relation("PurchaseOrderCreatedBy")

  campaignsCreated Campaign[] @relation("CampaignCreatedBy")

  leadsAssigned         Lead[]         @relation("LeadAssignedTo")
  leadActivitiesWritten LeadActivity[] @relation("LeadActivityAuthor")

  prospectsAssigned         Prospect[]           @relation("ProspectAssignedTo")
  prospectActivitiesWritten ProspectActivity[]   @relation("ProspectActivityAuthor")
  clientsManaged            ClientAccount[]      @relation("ClientAccountManager")
  clientActivitiesWritten   ClientActivity[]     @relation("ClientActivityAuthor")
  commissionsEarned         Commission[]         @relation("CommissionEarnedBy")
  commissionsCreated        Commission[]         @relation("CommissionCreatedBy")
  salesTargets              SalesTarget[]        @relation("SalesTargetOwner")
  consentFormsWitnessed     ConsentForm[]        @relation("ConsentWitnessedBy")
  consentFormsCreated       ConsentForm[]        @relation("ConsentCreatedBy")
  treatmentPhotosUploaded   TreatmentPhoto[]     @relation("TreatmentPhotoUploadedBy")
  loyaltyTransactionsMade   LoyaltyTransaction[] @relation("LoyaltyTransactionCreatedBy")
  attendance                StaffAttendance[]
  leaveRequests             StaffLeaveRequest[]  @relation("StaffLeaveRequestUser")
  leaveRequestsDecided      StaffLeaveRequest[]  @relation("StaffLeaveRequestDecidedBy")

  @@index([role])
}

// Server-side session for cookie-based auth (replaces the getCurrentUser() placeholder)
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Atomic named sequence counters (UHID / bill number / appointment ID generation)
model Counter {
  key   String @id
  value Int    @default(0)
}

// ─────────────────────────────────────────────────────────────────────────
// Patient — the single digital identity
// ─────────────────────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

// The real treatment categories the clinic offers (crown-celebrity-aesthetic.com) —
// what the patient is registering to be seen for.
enum CareCategory {
  HAIR_RESTORATION
  HAIR_TRANSPLANT
  SKIN_AND_LASER
  PERMANENT_MAKEUP
  ACADEMY
  SKIN_HAIR_LASER
  DIABETOLOGY
  GENERAL_MEDICINE
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
  UNKNOWN
}

enum PatientStatus {
  ACTIVE
  INACTIVE
}

model Patient {
  id             String        @id @default(cuid())
  uhid           String        @unique
  firstName      String
  lastName       String?
  dob            DateTime?
  gender         Gender?
  bloodGroup     BloodGroup?   @default(UNKNOWN)
  occupation     String?
  // Captured at registration for a quick baseline BMI; per-visit vitals still
  // live on Vitals (tied to an Encounter) — these are just the intake values.
  heightCm       Decimal?      @db.Decimal(5, 1)
  weightKg       Decimal?      @db.Decimal(5, 1)
  careCategory   CareCategory?
  phone          String
  alternatePhone String?
  email          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String?       @default("India")
  photoUrl       String?
  status         PatientStatus @default(ACTIVE)
  notesSummary   String?

  // set when the patient originates from a website booking rather than
  // front-desk registration, so the CRM can show its source
  source String? @default("CRM")

  registeredById String?
  registeredBy   User?   @relation("PatientRegisteredBy", fields: [registeredById], references: [id])

  registrationStatus RegistrationStatus @default(CONFIRMED)
  lockedAt           DateTime?
  lockedById         String?

  referralCode  String?   @unique
  referredById  String?
  referredBy    Patient?  @relation("PatientReferral", fields: [referredById], references: [id])
  referrals     Patient[] @relation("PatientReferral")
  loyaltyPoints Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags                    PatientTag[]
  familyMembers           FamilyMember[]
  insurances              Insurance[]
  emergencyContacts       EmergencyContact[]
  medicalAlerts           MedicalAlert[]
  allergies               Allergy[]
  chronicDiseases         ChronicDisease[]
  documents               Document[]
  consentForms            ConsentForm[]
  treatmentPhotos         TreatmentPhoto[]
  communicationPreference CommunicationPreference?
  appointments            Appointment[]
  waitingListEntries      WaitingListEntry[]
  prescriptions           Prescription[]
  bills                   Bill[]
  payments                Payment[]
  patientPackages         PatientPackage[]
  paymentPlans            PaymentPlan[]
  messages                Message[]
  notes                   PatientNote[]
  followUps               FollowUp[]
  feedback                Feedback[]
  loyaltyTransactions     LoyaltyTransaction[]
  relatedToFamilyOf       FamilyMember[]           @relation("RelatedPatient")

  encounters         Encounter[]
  medicalHistory     MedicalHistory[]
  familyHistory      FamilyHistoryEntry[]
  surgicalHistory    SurgicalHistory[]
  currentMedications CurrentMedication[]
  clinicalReports    ClinicalReport[]
  referralNotes      ReferralNote[]
  certificates       Certificate[]

  inventoryTransactions InventoryTransaction[]

  refunds  Refund[]
  advances PatientAdvance[]

  campaignRecipients CampaignRecipient[]

  convertedFromLeads     Lead[]
  convertedFromProspects Prospect[]
  clientAccounts         ClientAccount[]

  @@index([phone])
  @@index([email])
  @@index([status])
  @@index([registrationStatus])
  @@index([firstName, lastName])
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  color    String       @default("#1F6F78")
  patients PatientTag[]
}

model PatientTag {
  patientId String
  tagId     String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([patientId, tagId])
}

model FamilyMember {
  id                 String    @id @default(cuid())
  patientId          String
  patient            Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  relatedPatientId   String?
  relatedPatient     Patient?  @relation("RelatedPatient", fields: [relatedPatientId], references: [id])
  name               String
  relation           String
  phone              String?
  dob                DateTime?
  isEmergencyContact Boolean   @default(false)
  createdAt          DateTime  @default(now())

  @@index([patientId])
}

model Insurance {
  id             String    @id @default(cuid())
  patientId      String
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider       String
  policyNumber   String
  planName       String?
  coverageAmount Decimal?  @db.Decimal(12, 2)
  validFrom      DateTime?
  validTo        DateTime?
  isPrimary      Boolean   @default(true)
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())

  bills Bill[]

  @@index([patientId])
}

model EmergencyContact {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name      String
  relation  String
  phone     String
  altPhone  String?
  address   String?
  createdAt DateTime @default(now())

  @@index([patientId])
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertType {
  ALLERGY
  CONDITION
  DEVICE
  BEHAVIORAL
  OTHER
}

model MedicalAlert {
  id          String        @id @default(cuid())
  patientId   String
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type        AlertType
  severity    AlertSeverity @default(MEDIUM)
  description String
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())

  @@index([patientId])
}

model Allergy {
  id        String        @id @default(cuid())
  patientId String
  patient   Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  allergen  String
  reaction  String?
  severity  AlertSeverity @default(MEDIUM)
  notedOn   DateTime      @default(now())

  @@index([patientId])
}

enum ChronicDiseaseStatus {
  ACTIVE
  MANAGED
  RESOLVED
}

model ChronicDisease {
  id          String               @id @default(cuid())
  patientId   String
  patient     Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name        String
  diagnosedOn DateTime?
  status      ChronicDiseaseStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime             @default(now())

  @@index([patientId])
}

enum DocumentCategory {
  ID_PROOF
  INSURANCE
  LAB_REPORT
  PRESCRIPTION
  CONSENT_FORM
  OTHER
}

model Document {
  id           String           @id @default(cuid())
  patientId    String
  patient      Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title        String
  category     DocumentCategory @default(OTHER)
  fileUrl      String
  fileType     String?
  uploadedById String?
  uploadedBy   User?            @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt   DateTime         @default(now())

  prescription Prescription?

  @@index([patientId])
  @@index([category])
}

// Structured before/after progress photos tied to a treatment — previously
// only a single generic Patient.photoUrl existed, with no way to pair a
// before shot with its after shot or tie either to a specific procedure.
enum TreatmentPhotoType {
  BEFORE
  AFTER
}

model TreatmentPhoto {
  id            String             @id @default(cuid())
  patientId     String
  patient       Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment?       @relation(fields: [appointmentId], references: [id])
  type          TreatmentPhotoType
  photoUrl      String
  caption       String?
  takenAt       DateTime           @default(now())
  uploadedById  String?
  uploadedBy    User?              @relation("TreatmentPhotoUploadedBy", fields: [uploadedById], references: [id])

  @@index([patientId])
  @@index([appointmentId])
}

enum LoyaltyTransactionType {
  EARNED_REFERRAL
  REDEEMED
  ADJUSTED
}

model LoyaltyTransaction {
  id          String                 @id @default(cuid())
  patientId   String
  patient     Patient                @relation(fields: [patientId], references: [id], onDelete: Cascade)
  points      Int
  type        LoyaltyTransactionType
  reason      String?
  createdById String?
  createdBy   User?                  @relation("LoyaltyTransactionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime               @default(now())

  @@index([patientId])
}

// Procedure-specific consent — a Document can hold a scanned PDF, but
// nothing previously captured a structured, e-signed, procedure-specific
// consent record.
enum ConsentStatus {
  PENDING
  SIGNED
  DECLINED
}

model ConsentForm {
  id            String        @id @default(cuid())
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id])
  title         String
  content       String
  signatureUrl  String?
  signedAt      DateTime?
  witnessedById String?
  witnessedBy   User?         @relation("ConsentWitnessedBy", fields: [witnessedById], references: [id])
  status        ConsentStatus @default(PENDING)
  createdById   String?
  createdBy     User?         @relation("ConsentCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())

  @@index([patientId])
  @@index([status])
}

enum CommChannel {
  SMS
  EMAIL
  WHATSAPP
  CALL
  SYSTEM
}

model CommunicationPreference {
  id                String      @id @default(cuid())
  patientId         String      @unique
  patient           Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  preferredChannel  CommChannel @default(SMS)
  allowSms          Boolean     @default(true)
  allowEmail        Boolean     @default(true)
  allowWhatsapp     Boolean     @default(true)
  allowCall         Boolean     @default(true)
  allowMarketing    Boolean     @default(false)
  preferredLanguage String      @default("English")
  updatedAt         DateTime    @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// Services — the clinic's consultation catalog (Hairfall Review, Acne
// Review, Thyroid Review, ...). Admin-managed from the CRM; the public
// website reads this table to render service pages and drive booking.
// ─────────────────────────────────────────────────────────────────────────

model Service {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  shortDescription String?
  description      String?
  price            Decimal? @db.Decimal(10, 2)
  durationMinutes  Int      @default(30)
  displayOrder     Int      @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bills             Bill[]
  appointments      Appointment[]
  reviews           Review[]
  treatmentPackages TreatmentPackage[]
  consumables       ServiceConsumable[]

  @@index([active])
}

// The "recipe" of consumables (numbing cream, PRP kit, cannulas, etc.) a
// treatment uses — lets completing an appointment auto-deduct stock instead
// of relying on staff to remember a separate manual stock-out.
model ServiceConsumable {
  id                   String        @id @default(cuid())
  serviceId            String
  service              Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  inventoryItemId      String
  inventoryItem        InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  quantityPerProcedure Int           @default(1)

  @@unique([serviceId, inventoryItemId])
}

// ─────────────────────────────────────────────────────────────────────────
// Treatment packages — session-based protocols (FUE/DHI, laser courses, etc.)
// sold as a bundle. TreatmentPackage is the sellable catalog definition;
// PatientPackage is what a specific patient bought (with remaining-session
// tracking); PackageSessionLog records each individual session consumed.
// ─────────────────────────────────────────────────────────────────────────

model TreatmentPackage {
  id            String   @id @default(cuid())
  name          String
  description   String?
  serviceId     String?
  service       Service? @relation(fields: [serviceId], references: [id])
  totalSessions Int
  price         Decimal  @db.Decimal(12, 2)
  validityDays  Int?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patientPackages PatientPackage[]

  @@index([active])
}

enum PatientPackageStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

model PatientPackage {
  id            String               @id @default(cuid())
  patientId     String
  patient       Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  packageId     String
  package       TreatmentPackage     @relation(fields: [packageId], references: [id])
  billId        String?
  bill          Bill?                @relation(fields: [billId], references: [id])
  sessionsTotal Int
  sessionsUsed  Int                  @default(0)
  purchasedAt   DateTime             @default(now())
  expiresAt     DateTime?
  status        PatientPackageStatus @default(ACTIVE)
  notes         String?

  sessionLogs PackageSessionLog[]

  @@index([patientId])
  @@index([status])
}

model PackageSessionLog {
  id               String         @id @default(cuid())
  patientPackageId String
  patientPackage   PatientPackage @relation(fields: [patientPackageId], references: [id], onDelete: Cascade)
  appointmentId    String?
  appointment      Appointment?   @relation(fields: [appointmentId], references: [id])
  performedById    String?
  performedBy      User?          @relation("PackageSessionPerformedBy", fields: [performedById], references: [id])
  usedAt           DateTime       @default(now())
  notes            String?

  @@index([patientPackageId])
}

// ─────────────────────────────────────────────────────────────────────────
// Appointment system
// ─────────────────────────────────────────────────────────────────────────

model DoctorAvailability {
  id                  String  @id @default(cuid())
  doctorId            String
  doctor              User    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek           Int // 0 = Sunday .. 6 = Saturday
  startTime           String // "18:00"
  endTime             String // "22:00"
  slotDurationMinutes Int     @default(30)
  isActive            Boolean @default(true)

  @@index([doctorId])
}

model DoctorLeave {
  id        String   @id @default(cuid())
  doctorId  String
  doctor    User     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([doctorId, date])
}

enum AttendanceStatus {
  PRESENT
  HALF_DAY
  ON_LEAVE
  ABSENT
}

model StaffAttendance {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  checkInAt  DateTime?
  checkOutAt DateTime?
  status     AttendanceStatus @default(PRESENT)
  createdAt  DateTime         @default(now())

  @@unique([userId, date])
  @@index([date])
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model StaffLeaveRequest {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation("StaffLeaveRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  startDate   DateTime           @db.Date
  endDate     DateTime           @db.Date
  reason      String
  status      LeaveRequestStatus @default(PENDING)
  decidedById String?
  decidedBy   User?              @relation("StaffLeaveRequestDecidedBy", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  createdAt   DateTime           @default(now())

  @@index([userId])
  @@index([status])
}

// Treatment rooms and equipment (laser machines, FUE/DHI stations) that can
// be double-booked if nothing tracks which appointment is using which one.
enum ResourceType {
  ROOM
  EQUIPMENT
}

model Resource {
  id          String       @id @default(cuid())
  name        String
  type        ResourceType
  description String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())

  appointments Appointment[]

  @@index([active])
}

enum AppointmentType {
  IN_PERSON
  WALK_IN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  ARRIVED
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum AppointmentSource {
  WEBSITE
  CRM
  PHONE
}

model Appointment {
  id                  String            @id @default(cuid())
  appointmentCode     String            @unique
  patientId           String
  patient             Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId            String
  doctor              User              @relation("AppointmentDoctor", fields: [doctorId], references: [id])
  serviceId           String?
  service             Service?          @relation(fields: [serviceId], references: [id])
  resourceId          String?
  resource            Resource?         @relation(fields: [resourceId], references: [id])
  scheduledAt         DateTime
  durationMinutes     Int               @default(30)
  type                AppointmentType   @default(IN_PERSON)
  status              AppointmentStatus @default(PENDING)
  source              AppointmentSource @default(CRM)
  reason              String?
  notes               String?
  cancelReason        String?
  cancelledAt         DateTime?
  checkedInAt         DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  consumablesDeducted Boolean           @default(false)
  reminderSentAt      DateTime?
  aftercareSentAt     DateTime?
  reviewRequestSentAt DateTime?

  rescheduledFromId String?
  rescheduledFrom   Appointment?  @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo     Appointment[] @relation("AppointmentReschedule")

  createdById String?
  createdBy   User?    @relation("AppointmentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  bills              Bill[]
  prescriptions      Prescription[]
  feedback           Feedback[]
  followUps          FollowUp[]
  encounters         Encounter[]
  packageSessionLogs PackageSessionLog[]
  consentForms       ConsentForm[]
  treatmentPhotos    TreatmentPhoto[]

  @@index([patientId])
  @@index([doctorId, scheduledAt])
  @@index([status])
}

enum WaitingListStatus {
  WAITING
  NOTIFIED
  CONVERTED
  EXPIRED
}

model WaitingListEntry {
  id            String            @id @default(cuid())
  patientId     String
  patient       Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String?
  doctor        User?             @relation("WaitingListDoctor", fields: [doctorId], references: [id])
  requestedDate DateTime?
  reason        String?
  priority      Int               @default(0)
  status        WaitingListStatus @default(WAITING)
  // Mandatory vitals captured at time of waitlisting.
  bpSystolic    Int
  bpDiastolic   Int
  heightCm      Decimal           @db.Decimal(5, 1)
  weightKg      Decimal           @db.Decimal(5, 1)
  temperatureC  Decimal           @db.Decimal(4, 1)
  createdAt     DateTime          @default(now())

  @@index([patientId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────
// Prescriptions / Billing / Payments
// ─────────────────────────────────────────────────────────────────────────

enum PrescriptionSource {
  DIGITAL
  SCANNED
}

model Prescription {
  id                 String             @id @default(cuid())
  prescriptionNumber String?            @unique
  patientId          String
  patient            Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId           String
  doctor             User               @relation("PrescriptionDoctor", fields: [doctorId], references: [id])
  appointmentId      String?
  appointment        Appointment?       @relation(fields: [appointmentId], references: [id])
  encounterId        String?
  encounter          Encounter?         @relation(fields: [encounterId], references: [id])
  source             PrescriptionSource @default(DIGITAL)
  documentId         String?            @unique
  document           Document?          @relation(fields: [documentId], references: [id])
  diagnosis          String?
  weightAtVisit      String?
  advice             String?
  reviewAfter        String?
  notes              String?
  issuedAt           DateTime           @default(now())

  items PrescriptionItem[]

  @@index([patientId])
  @@index([encounterId])
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineName   String
  dosage         String?
  frequency      String?
  duration       String?
  instructions   String?

  @@index([prescriptionId])
}

enum BillStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  CANCELLED
  REFUNDED
}

model Bill {
  id             String       @id @default(cuid())
  billNumber     String       @unique
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  insuranceId    String?
  insurance      Insurance?   @relation(fields: [insuranceId], references: [id])
  serviceId      String?
  service        Service?     @relation(fields: [serviceId], references: [id])
  totalAmount    Decimal      @default(0) @db.Decimal(12, 2)
  discountAmount Decimal      @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal      @default(0) @db.Decimal(12, 2)
  netAmount      Decimal      @default(0) @db.Decimal(12, 2)
  amountPaid     Decimal      @default(0) @db.Decimal(12, 2)
  balanceDue     Decimal      @default(0) @db.Decimal(12, 2)
  status         BillStatus   @default(PENDING)
  issuedAt       DateTime     @default(now())
  cancelledAt    DateTime?

  items              BillItem[]
  payments           Payment[]
  refunds            Refund[]
  advanceAdjustments AdvanceAdjustment[]
  patientPackages    PatientPackage[]
  paymentPlan        PaymentPlan?
  commissions        Commission[]

  @@index([patientId])
  @@index([status])
}

model BillItem {
  id             String  @id @default(cuid())
  billId         String
  bill           Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  description    String
  quantity       Int     @default(1)
  unitPrice      Decimal @db.Decimal(12, 2)
  taxRatePercent Decimal @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  amount         Decimal @db.Decimal(12, 2)

  @@index([billId])
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  NET_BANKING
  INSURANCE
  ADVANCE
  EMI
}

enum PaymentStatus {
  SUCCESS
  PENDING
  FAILED
  REFUNDED
}

model Payment {
  id              String        @id @default(cuid())
  receiptNumber   String        @unique
  patientId       String
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  billId          String?
  bill            Bill?         @relation(fields: [billId], references: [id])
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  status          PaymentStatus @default(SUCCESS)
  referenceNumber String?
  cashSessionId   String?
  cashSession     CashSession?  @relation(fields: [cashSessionId], references: [id])
  receivedById    String?
  receivedBy      User?         @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  paidAt          DateTime      @default(now())

  refunds     Refund[]
  installment Installment?

  @@index([patientId])
  @@index([cashSessionId])
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model Refund {
  id            String        @id @default(cuid())
  billId        String?
  bill          Bill?         @relation(fields: [billId], references: [id])
  paymentId     String?
  payment       Payment?      @relation(fields: [paymentId], references: [id])
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(12, 2)
  reason        String
  method        PaymentMethod
  status        RefundStatus  @default(PENDING)
  requestedAt   DateTime      @default(now())
  processedAt   DateTime?
  processedById String?
  processedBy   User?         @relation("RefundProcessedBy", fields: [processedById], references: [id])

  @@index([patientId])
  @@index([status])
}

model PatientAdvance {
  id              String        @id @default(cuid())
  patientId       String
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  amount          Decimal       @db.Decimal(12, 2)
  balance         Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  referenceNumber String?
  receivedById    String?
  receivedBy      User?         @relation("AdvanceReceivedBy", fields: [receivedById], references: [id])
  paidAt          DateTime      @default(now())
  notes           String?

  adjustments AdvanceAdjustment[]

  @@index([patientId])
}

model AdvanceAdjustment {
  id         String         @id @default(cuid())
  advanceId  String
  advance    PatientAdvance @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  billId     String
  bill       Bill           @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount     Decimal        @db.Decimal(12, 2)
  adjustedAt DateTime       @default(now())

  @@index([advanceId])
  @@index([billId])
}

// ─────────────────────────────────────────────────────────────────────────
// Sales commissions & targets — Lead/Prospect/ClientAccount track an
// assigned rep, but nothing recorded commission rate, payout, or targets
// for that "sales team" persona.
// ─────────────────────────────────────────────────────────────────────────

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

model Commission {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation("CommissionEarnedBy", fields: [userId], references: [id], onDelete: Cascade)
  billId      String?
  bill        Bill?            @relation(fields: [billId], references: [id])
  saleAmount  Decimal          @db.Decimal(12, 2)
  ratePercent Decimal?         @db.Decimal(5, 2)
  amount      Decimal          @db.Decimal(12, 2)
  status      CommissionStatus @default(PENDING)
  notes       String?
  createdById String?
  createdBy   User?            @relation("CommissionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  paidAt      DateTime?

  @@index([userId])
  @@index([status])
}

model SalesTarget {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("SalesTargetOwner", fields: [userId], references: [id], onDelete: Cascade)
  periodStart  DateTime
  periodEnd    DateTime
  targetAmount Decimal  @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// EMI / installment payment plans — the marketing site advertises "No Cost
// EMI" on treatments, but nothing previously tracked an installment
// schedule, due dates, or remaining balance for it.
// ─────────────────────────────────────────────────────────────────────────

enum PaymentPlanStatus {
  ACTIVE
  COMPLETED
  DEFAULTED
  CANCELLED
}

model PaymentPlan {
  id                   String            @id @default(cuid())
  billId               String            @unique
  bill                 Bill              @relation(fields: [billId], references: [id], onDelete: Cascade)
  patientId            String
  patient              Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  totalAmount          Decimal           @db.Decimal(12, 2)
  downPayment          Decimal           @default(0) @db.Decimal(12, 2)
  numberOfInstallments Int
  noCostEmi            Boolean           @default(true)
  status               PaymentPlanStatus @default(ACTIVE)
  notes                String?
  createdById          String?
  createdBy            User?             @relation("PaymentPlanCreatedBy", fields: [createdById], references: [id])
  createdAt            DateTime          @default(now())

  installments Installment[]

  @@index([patientId])
  @@index([status])
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
}

model Installment {
  id                String            @id @default(cuid())
  paymentPlanId     String
  paymentPlan       PaymentPlan       @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  installmentNumber Int
  dueDate           DateTime
  amount            Decimal           @db.Decimal(12, 2)
  status            InstallmentStatus @default(PENDING)
  paidAt            DateTime?
  paymentId         String?           @unique
  payment           Payment?          @relation(fields: [paymentId], references: [id])

  @@index([paymentPlanId])
  @@index([status, dueDate])
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

model CashSession {
  id              String            @id @default(cuid())
  openedById      String
  openedBy        User              @relation("CashSessionOpenedBy", fields: [openedById], references: [id])
  closedById      String?
  closedBy        User?             @relation("CashSessionClosedBy", fields: [closedById], references: [id])
  openingBalance  Decimal           @default(0) @db.Decimal(12, 2)
  closingBalance  Decimal?          @db.Decimal(12, 2)
  expectedClosing Decimal?          @db.Decimal(12, 2)
  status          CashSessionStatus @default(OPEN)
  openedAt        DateTime          @default(now())
  closedAt        DateTime?
  notes           String?

  payments Payment[]

  @@index([status])
}

enum ExpenseCategory {
  UTILITIES
  SUPPLIES
  MAINTENANCE
  MARKETING
  RENT
  EQUIPMENT
  OTHER
}

model Expense {
  id              String          @id @default(cuid())
  category        ExpenseCategory
  description     String
  amount          Decimal         @db.Decimal(12, 2)
  expenseDate     DateTime        @default(now())
  paidTo          String?
  method          PaymentMethod
  referenceNumber String?
  recordedById    String?
  recordedBy      User?           @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])
  createdAt       DateTime        @default(now())

  @@index([category])
  @@index([expenseDate])
}

// ─────────────────────────────────────────────────────────────────────────
// CRM — Notes, Follow-ups, Communication log, Feedback
// ─────────────────────────────────────────────────────────────────────────

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

model Message {
  id        String           @id @default(cuid())
  patientId String
  patient   Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  channel   CommChannel
  direction MessageDirection @default(OUTBOUND)
  subject   String?
  body      String
  status    MessageStatus    @default(SENT)
  sentById  String?
  sentBy    User?            @relation("MessageSentBy", fields: [sentById], references: [id])
  sentAt    DateTime         @default(now())

  @@index([patientId])
  @@index([channel])
}

// ─────────────────────────────────────────────────────────────────────────
// WhatsApp Broadcasts — bulk campaigns, separate from the one-to-one
// Message log above. Sending is currently a stub: no WhatsApp Business API
// credentials are configured anywhere in this repo/environment, so
// publishCampaign() never contacts a real provider — see ClinicSettings
// below and src/actions/broadcasts.ts.
// ─────────────────────────────────────────────────────────────────────────

model MessageTemplate {
  id                String   @id @default(cuid())
  name              String
  body              String // supports {{patientName}}, {{date}}, {{time}}, {{doctorName}}
  quickReplyButtons String[] @default([])
  approved          Boolean  @default(false)
  createdAt         DateTime @default(now())

  campaigns Campaign[]
}

enum CampaignStatus {
  DRAFT
  QUEUED
  SENT
  FAILED
}

model Campaign {
  id            String           @id @default(cuid())
  name          String
  templateId    String?
  template      MessageTemplate? @relation(fields: [templateId], references: [id])
  audienceCount Int              @default(0)
  status        CampaignStatus   @default(DRAFT)
  createdById   String?
  createdBy     User?            @relation("CampaignCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())
  sentAt        DateTime?

  recipients CampaignRecipient[]
}

enum CampaignRecipientStatus {
  PENDING
  DELIVERED
  FAILED
}

model CampaignRecipient {
  id         String                  @id @default(cuid())
  campaignId String
  campaign   Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  patientId  String
  patient    Patient                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  status     CampaignRecipientStatus @default(PENDING)
  failReason String?
  sentAt     DateTime?

  @@index([campaignId])
  @@index([patientId])
}

enum NoteCategory {
  GENERAL
  CLINICAL
  BILLING
  FRONT_DESK
}

model PatientNote {
  id        String       @id @default(cuid())
  patientId String
  patient   Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?        @relation("NoteAuthor", fields: [authorId], references: [id])
  body      String
  category  NoteCategory @default(GENERAL)
  pinned    Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([patientId])
}

enum FollowUpStatus {
  PENDING
  DONE
  MISSED
  CANCELLED
}

model FollowUp {
  id            String         @id @default(cuid())
  patientId     String
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  assignedToId  String?
  assignedTo    User?          @relation("FollowUpAssignedTo", fields: [assignedToId], references: [id])
  dueDate       DateTime
  reason        String
  status        FollowUpStatus @default(PENDING)
  notes         String?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())

  @@index([patientId])
  @@index([status, dueDate])
}

// Internal (CRM-side) feedback captured after a visit — distinct from the
// public-facing Review model below, which is admin-curated for the website.
model Feedback {
  id            String       @id @default(cuid())
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  rating        Int
  comment       String?
  category      String?
  createdAt     DateTime     @default(now())

  @@index([patientId])
}

// ─────────────────────────────────────────────────────────────────────────
// EMR — Encounter is the anchor for a single consultation: chief
// complaints, vitals, diagnoses, the SOAP note, and prescriptions issued
// during that visit all hang off it.
// ─────────────────────────────────────────────────────────────────────────

enum EncounterStatus {
  DRAFT
  FINALIZED
}

model Encounter {
  id              String          @id @default(cuid())
  patientId       String
  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String
  doctor          User            @relation("EncounterDoctor", fields: [doctorId], references: [id])
  appointmentId   String?
  appointment     Appointment?    @relation(fields: [appointmentId], references: [id])
  encounterDate   DateTime        @default(now())
  chiefComplaints String[]
  status          EncounterStatus @default(DRAFT)
  signedAt        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  vitals        Vitals[]
  diagnoses     Diagnosis[]
  clinicalNote  ClinicalNote?
  prescriptions Prescription[]
  reports       ClinicalReport[]

  @@index([patientId])
  @@index([doctorId])
}

model Vitals {
  id           String    @id @default(cuid())
  encounterId  String
  encounter    Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patientId    String
  heightCm     Decimal?  @db.Decimal(5, 1)
  weightKg     Decimal?  @db.Decimal(5, 1)
  bmi          Decimal?  @db.Decimal(4, 1)
  temperatureC Decimal?  @db.Decimal(4, 1)
  pulseBpm     Int?
  bpSystolic   Int?
  bpDiastolic  Int?
  spo2         Int?
  recordedAt   DateTime  @default(now())

  @@index([encounterId])
  @@index([patientId])
}

enum DiagnosisType {
  PRIMARY
  SECONDARY
  DIFFERENTIAL
}

enum DiagnosisStatus {
  ACTIVE
  RESOLVED
}

model Diagnosis {
  id          String          @id @default(cuid())
  encounterId String
  encounter   Encounter       @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patientId   String
  description String
  icdCode     String?
  type        DiagnosisType   @default(PRIMARY)
  status      DiagnosisStatus @default(ACTIVE)
  createdAt   DateTime        @default(now())

  @@index([encounterId])
  @@index([patientId])
}

enum ClinicalNoteStatus {
  DRAFT
  SIGNED
}

model ClinicalNote {
  id          String             @id @default(cuid())
  encounterId String             @unique
  encounter   Encounter          @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patientId   String
  doctorId    String
  doctor      User               @relation("ClinicalNoteDoctor", fields: [doctorId], references: [id])
  subjective  String?
  objective   String?
  assessment  String?
  plan        String?
  status      ClinicalNoteStatus @default(DRAFT)
  version     Int                @default(1)
  signedAt    DateTime?
  updatedAt   DateTime           @updatedAt
  createdAt   DateTime           @default(now())

  versions ClinicalNoteVersion[]

  @@index([patientId])
}

model ClinicalNoteVersion {
  id             String       @id @default(cuid())
  clinicalNoteId String
  clinicalNote   ClinicalNote @relation(fields: [clinicalNoteId], references: [id], onDelete: Cascade)
  versionNumber  Int
  subjective     String?
  objective      String?
  assessment     String?
  plan           String?
  savedAt        DateTime     @default(now())

  @@index([clinicalNoteId])
}

model MedicalHistory {
  id          String    @id @default(cuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  description String
  occurredOn  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([patientId])
}

model FamilyHistoryEntry {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  relation  String
  condition String
  notes     String?
  createdAt DateTime @default(now())

  @@index([patientId])
}

model SurgicalHistory {
  id          String    @id @default(cuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  procedure   String
  surgeryDate DateTime?
  surgeon     String?
  hospital    String?
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([patientId])
}

enum MedicationStatus {
  ACTIVE
  STOPPED
}

model CurrentMedication {
  id           String           @id @default(cuid())
  patientId    String
  patient      Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicineName String
  dosage       String?
  frequency    String?
  startDate    DateTime?
  endDate      DateTime?
  status       MedicationStatus @default(ACTIVE)
  prescribedBy String?
  notes        String?
  createdAt    DateTime         @default(now())

  @@index([patientId])
}

enum DoctorTemplateType {
  SOAP
  PRESCRIPTION
  CERTIFICATE
}

model DoctorTemplate {
  id         String             @id @default(cuid())
  doctorId   String
  doctor     User               @relation("DoctorTemplateOwner", fields: [doctorId], references: [id], onDelete: Cascade)
  name       String
  type       DoctorTemplateType
  subjective String?
  objective  String?
  assessment String?
  plan       String?
  content    String?
  createdAt  DateTime           @default(now())

  @@index([doctorId])
}

model DigitalSignature {
  id           String   @id @default(cuid())
  doctorId     String   @unique
  doctor       User     @relation("DoctorSignature", fields: [doctorId], references: [id], onDelete: Cascade)
  signatureUrl String
  updatedAt    DateTime @updatedAt
}

enum ClinicalReportType {
  LAB
  RADIOLOGY
}

enum ClinicalReportStatus {
  PENDING
  COMPLETED
}

model ClinicalReport {
  id            String               @id @default(cuid())
  patientId     String
  patient       Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String?
  doctor        User?                @relation("ClinicalReportDoctor", fields: [doctorId], references: [id])
  encounterId   String?
  encounter     Encounter?           @relation(fields: [encounterId], references: [id])
  type          ClinicalReportType
  title         String
  modality      String?
  findings      String?
  impression    String?
  status        ClinicalReportStatus @default(PENDING)
  reportDate    DateTime             @default(now())
  attachmentUrl String?
  createdAt     DateTime             @default(now())

  labResults LabResultItem[]

  @@index([patientId])
  @@index([type])
}

enum ResultFlag {
  NORMAL
  LOW
  HIGH
  CRITICAL
}

model LabResultItem {
  id             String         @id @default(cuid())
  reportId       String
  report         ClinicalReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  testName       String
  value          String
  unit           String?
  referenceRange String?
  flag           ResultFlag     @default(NORMAL)

  @@index([reportId])
}

enum ReferralUrgency {
  ROUTINE
  URGENT
}

model ReferralNote {
  id           String          @id @default(cuid())
  patientId    String
  patient      Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  fromDoctorId String
  fromDoctor   User            @relation("ReferralFromDoctor", fields: [fromDoctorId], references: [id])
  toDoctor     String
  toSpecialty  String?
  reason       String
  notes        String?
  urgency      ReferralUrgency @default(ROUTINE)
  signedAt     DateTime?
  createdAt    DateTime        @default(now())

  @@index([patientId])
}

enum CertificateType {
  FITNESS
  SICK_LEAVE
  MEDICAL
  OTHER
}

model Certificate {
  id        String          @id @default(cuid())
  patientId String
  patient   Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    User            @relation("CertificateDoctor", fields: [doctorId], references: [id])
  type      CertificateType
  title     String
  content   String
  validFrom DateTime?
  validTo   DateTime?
  signedAt  DateTime?
  createdAt DateTime        @default(now())

  @@index([patientId])
}

// ─────────────────────────────────────────────────────────────────────────
// Website content management — lets clinic admins edit the public site
