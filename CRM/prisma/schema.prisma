  patientName  String
  rating       Int
  comment      String
  serviceId    String?
  service      Service? @relation(fields: [serviceId], references: [id])
  published    Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// Registration Status & Locking
// ─────────────────────────────────────────────────────────────────────────

enum RegistrationStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  LOCKED_FOR_RECEPTIONIST
}

// ─────────────────────────────────────────────────────────────────────────
// Inventory System — Medicines, Stock In/Out, 20% Alerts
// ─────────────────────────────────────────────────────────────────────────

model InventoryItem {
  id                       String   @id @default(cuid())
  name                     String
  category                 String   @default("Medicine")
  manufacturer             String?
  sku                      String   @unique
  unit                     String   @default("Unit")
  description              String?
  currentStock             Int      @default(0)
  referenceStock           Int      @default(20)
  lowStockThresholdPercent Decimal  @default(20) @db.Decimal(5, 2)
  lowStockThresholdQty     Int      @default(4)
  unitPrice                Decimal? @db.Decimal(10, 2)
  active                   Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  transactions       InventoryTransaction[]
  alerts             InventoryAlert[]
  batches            InventoryBatch[]
  serviceLinks       ServiceConsumable[]
  purchaseOrderLines PurchaseOrderItem[]

  @@index([category])
  @@index([active])
  @@index([name])
}

// A received lot of stock with its own expiry date — items are dispensed
// oldest-expiry-first (FEFO). Without this, nothing catches an expired PRP
// kit, botox vial, or filler being used on a patient.
model InventoryBatch {
  id                String        @id @default(cuid())
  itemId            String
  item              InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batchNumber       String?
  expiryDate        DateTime
  quantityReceived  Int
  quantityRemaining Int
  receivedAt        DateTime      @default(now())

  @@index([itemId])
  @@index([expiryDate])
}

enum InventoryTransactionType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  RETURN
}

model InventoryTransaction {
  id            String                   @id @default(cuid())
  itemId        String
  item          InventoryItem            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type          InventoryTransactionType
  quantity      Int
  previousStock Int
  newStock      Int
  reason        String?
  patientId     String?
  patient       Patient?                 @relation(fields: [patientId], references: [id])
  performedById String
  performedBy   User                     @relation("InventoryPerformedBy", fields: [performedById], references: [id])
  timestamp     DateTime                 @default(now())

  @@index([itemId])
  @@index([type])
  @@index([performedById])
  @@index([timestamp])
}

// ─────────────────────────────────────────────────────────────────────────
// Suppliers & purchase orders — reordering and vendor comparison previously
// lived entirely outside the system.
// ─────────────────────────────────────────────────────────────────────────

model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  purchaseOrders PurchaseOrder[]

  @@index([active])
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  poNumber    String              @unique
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  status      PurchaseOrderStatus @default(DRAFT)
  orderedAt   DateTime?
  expectedAt  DateTime?
  receivedAt  DateTime?
  notes       String?
  createdById String?
  createdBy   User?               @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime            @default(now())

  items PurchaseOrderItem[]

  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItemId  String
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantityOrdered  Int
  quantityReceived Int           @default(0)
  unitCost         Decimal?      @db.Decimal(10, 2)

  @@index([purchaseOrderId])
}

enum InventoryAlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

enum InventoryAlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model InventoryAlert {
  id                String                 @id @default(cuid())
  itemId            String
  item              InventoryItem          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  alertType         String                 @default("LOW_STOCK")
  severity          InventoryAlertSeverity @default(HIGH)
  currentQuantity   Int
  thresholdQuantity Int
  status            InventoryAlertStatus   @default(ACTIVE)
  acknowledgedAt    DateTime?
  acknowledgedById  String?
  resolvedAt        DateTime?
  resolvedById      String?
  notes             String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([itemId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────
// Audit Logging
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation("AuditUser", fields: [userId], references: [id])
  userName   String?
  userRole   String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  timestamp  DateTime @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([timestamp])
}

// ─────────────────────────────────────────────────────────────────────────
// WhatsApp bulk messaging (Meta WhatsApp Cloud API)
// ─────────────────────────────────────────────────────────────────────────

model WhatsAppTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String   @default("General")
  // Supports {{firstName}}, {{clinicName}}, {{clinicPhone}} placeholders
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// Sales & CRM Pipeline (Leads, Deal Pipeline, Overdue Follow-ups, Activities)
// ─────────────────────────────────────────────────────────────────────────

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DEMO
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  LINKEDIN
  WEBSITE
  INSTAGRAM
  WHATSAPP
  GOOGLE
  REFERRAL
  WALK_IN
  PHONE
  OTHER
}

model Lead {
  id                 String     @id @default(cuid())
  name               String
  company            String?
  email              String?
  phone              String?
  status             LeadStatus @default(NEW)
  source             LeadSource @default(WEBSITE)
  sourceDetail       String?
  value              Decimal?   @db.Decimal(12, 2)
  icpScore           Int?       @default(5) // 0 to 10 scale
  assignedToId       String?
  assignedTo         User?      @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  followUpDate       DateTime?
  notes              String?
  lostReason         String?
  convertedPatientId String?
  convertedPatient   Patient?   @relation(fields: [convertedPatientId], references: [id])
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  activities LeadActivity[]

  @@index([status])
  @@index([assignedToId])
  @@index([followUpDate])
  @@index([createdAt])
}

/**
 * Marketing spend per lead source, entered manually by staff, used to compute ROI.
 */
model LeadSourceSpend {
  id        String     @id @default(cuid())
  source    LeadSource @unique
  amount    Decimal    @default(0) @db.Decimal(12, 2)
  updatedAt DateTime   @updatedAt
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String // "STATUS_CHANGE" | "NOTE" | "CALL" | "EMAIL" | "FOLLOW_UP"
  title     String
  details   String?
  authorId  String?
  author    User?    @relation("LeadActivityAuthor", fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Sales Pipeline: Prospects & Client Lifecycle Management
// ─────────────────────────────────────────────────────────────────────────

enum ProspectStage {
  QUALIFIED
  DEMO_BOOKED
  PROPOSAL_SENT
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

model Prospect {
  id           String        @id @default(cuid())
  name         String
  company      String?
  email        String?
  phone        String?
  stage        ProspectStage @default(QUALIFIED)
  value        Decimal?      @db.Decimal(12, 2)
  icpScore     Int?          @default(7) // 0 to 10
  engagement   Int?          @default(25) // 0 to 100 percentage
  dueDate      DateTime?
  assignedToId String?
  assignedTo   User?         @relation("ProspectAssignedTo", fields: [assignedToId], references: [id])
  notes        String?
  source       String?       @default("QUALIFIED_LEAD")

  // Clinical Skin & Hair Fields
  treatmentCategory String? // "HAIR_RESTORATION" | "HAIR_TRANSPLANT" | "SKIN_AESTHETICS" | "ANTI_AGING" | "ACNE_SCARS" | "BRIDAL" | "PMU"
  treatmentInterest String? // e.g. "FUE Hair Transplant (3,000 Grafts)", "GFC Protocol (4 Sessions)"
  candidateConcern  String? // e.g. "Norwood Stage 3 Receding Temples", "Deep Atrophic Acne Scars"
  doctorPreference  String? // e.g. "Dr. Naziya Baig", "Reehal Baig", "Hair Transplant Team (Satyam Centre)"

  leadId             String?
  convertedClientId  String?
  convertedClient    ClientAccount? @relation("ProspectConvertedClient", fields: [convertedClientId], references: [id])
  convertedPatientId String?
  convertedPatient   Patient?       @relation(fields: [convertedPatientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities ProspectActivity[]

  @@index([stage])
  @@index([assignedToId])
  @@index([treatmentCategory])
  @@index([dueDate])
  @@index([createdAt])
}

model ProspectActivity {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  type       String // "STAGE_CHANGE" | "NOTE" | "CALL" | "DEMO" | "PROPOSAL"
  title      String
  details    String?
  authorId   String?
  author     User?    @relation("ProspectActivityAuthor", fields: [authorId], references: [id])
  createdAt  DateTime @default(now())

  @@index([prospectId])
  @@index([createdAt])
}

enum ClientStatus {
  ACTIVE
  AT_RISK
  CHURNED
  PAUSED
}

enum RenewalStage {
  NOT_STARTED
  IN_DISCUSSION
  PROPOSAL_SENT
  CONFIRMED
  COMPLETED
}

model ClientAccount {
  id                 String       @id @default(cuid())
  name               String
  company            String? // Organization / Retainer Name e.g. "Celebrity Black VIP Skin Passport"
  email              String?
  phone              String?
  status             ClientStatus @default(ACTIVE)
  healthScore        Int          @default(50) // e.g. 50, 55, 80
  accountManagerId   String?
  accountManager     User?        @relation("ClientAccountManager", fields: [accountManagerId], references: [id])
  accountManagerName String? // e.g. "Dr. Naziya Baig", "Reehal Baig", "Bhumika R", "Touhid Ahmed"
  contractValue      Decimal      @default(0) @db.Decimal(12, 2)
  renewalDate        DateTime?
  renewalStage       RenewalStage @default(NOT_STARTED)
  notes              String?

  // Clinical Aesthetic Retainer Fields
  membershipTier   String? // e.g. "Celebrity Black VIP", "Annual Hair Rejuvenation Retainer", "Annual Glow Pass"
  treatmentFocus   String? // e.g. "Trichology (Hair Restoration)", "Cosmetology (Advanced Skin & Peels)", "Anti-Aging Aesthetics"
  boosterFrequency String? // e.g. "Monthly", "Quarterly", "Bi-Annual"

  convertedFromProspects Prospect[] @relation("ProspectConvertedClient")

  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities ClientActivity[]

  @@index([status])
  @@index([renewalStage])
  @@index([accountManagerId])
  @@index([renewalDate])
}

model ClientActivity {
  id              String        @id @default(cuid())
  clientAccountId String
  clientAccount   ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  type            String // "STATUS_CHANGE" | "RENEWAL_UPDATE" | "PAYMENT" | "NOTE"
  title           String
  details         String?
  authorId        String?
  author          User?         @relation("ClientActivityAuthor", fields: [authorId], references: [id])
  createdAt       DateTime      @default(now())

  @@index([clientAccountId])
  @@index([createdAt])
}
