  landmark    String @default("Near J.P. Nagar / Satyam Centre")
  phone       String @default("9591047171")
  email       String @default("celebrityaestheticcrown@gmail.com")
  mapQuery    String @default("The Celebrity Aesthetics, Hair PRP, Permanent Makeup - Satyam Hair Transplant Centre, Bangalore")

  weekdayOpen  String  @default("10:00") // Mon-Sat
  weekdayClose String  @default("20:00")
  sundayClosed Boolean @default(false)

  heroHeadline String? @default("Advanced Hair Restoration, Clinical Skin Aesthetics & Permanent Makeup.")
  aboutText    String? @default("Crown Celebrity Aesthetic brings skin, hair, aesthetics and PMU services together within one consultation-led practice in Bangalore.")

  // WhatsApp Business API connection — stub only. No credentials are
  // configured anywhere in this repo/environment; Broadcasts (see
