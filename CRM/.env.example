# Supabase PostgreSQL Connection for Crown Celebrity Aesthetic CRM
# Pooler Connection (Transaction mode via port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct / Session Connection (Port 5432 for migrations & prisma db push)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Supabase Project API & Authentication
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
SUPABASE_JWKS_URL="https://[PROJECT_REF].supabase.co/auth/v1/.well-known/jwks.json"

# Optional notification keys
EMAIL_API_KEY=""
RESEND_API_KEY=""
SMS_API_KEY=""
TWILIO_AUTH_TOKEN=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Vercel Blob (optional; falls back to local disk storage in public/uploads)
BLOB_READ_WRITE_TOKEN=""

# Public site origins allowed to call the booking API
PUBLIC_SITE_ORIGIN=""

# Secret checked in /api/cron/reminders (Authorization: Bearer $CRON_SECRET).
# Required in production — Vercel Cron should be configured to send it, and
# without it set the endpoint has no auth check at all.
CRON_SECRET=""

# Link sent in post-visit review-request SMS (defaults to a placeholder if unset)
GOOGLE_REVIEW_URL=""
