{
  "name": "celebrity-aesthetic-suite",
  "version": "1.0.0",
  "private": true,
  "description": "Celebrity Aesthetic Suite - Clinic Management System (CRM) & Patient Website",
  "workspaces": [
    "CRM",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n \"CRM,WEB\" -c \"blue,magenta\" \"npm --prefix CRM run dev\" \"npm --prefix web run dev\"",
    "dev:crm": "npm --prefix CRM run dev",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix CRM run build && npm --prefix web run build",
    "build:crm": "npm --prefix CRM run build",
    "build:web": "npm --prefix web run build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@tailwindcss/oxide-linux-x64-musl": "4.3.3",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-linux-x64-musl": "1.32.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.9.1": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/engines@7.9.1": true
  }
}
